# Computer Use Agent - Configuration

# === Provider API Keys ===
# Set the key for the provider you want to use.
# The agent will auto-detect which keys are available.

# OpenRouter (Free models available) - https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# OpenAI (GPT-4o) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic (Claude) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (Local, no key needed) - https://ollama.ai
# Just install Ollama and pull a model: ollama pull llama3.3:70b

# === LLM Configuration (Optional) ===
# Default provider URL (auto-set based on provider selection)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default model (optional - prompted at startup)
LLM_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# Model parameters
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.95
